{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "scripts/test-shard.mjs",
    "scripts/test-weights.json",
    "tsconfig.base.json",
    "bench/perf/budgets.json",
    "bench/perf/src/perf.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": [
        "SHARD_BENCH",
        "SHARD_BUDGETS",
        "SHARD_CI",
        "SHARD_DAWN_OPTIONS",
        "SHARD_PERF_REPORT",
        "SHARD_SCENARIO",
        "SHARD_TEST_SHARD",
        "SHARD_TIER",
        "SHARD_WGSL_LOG"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
