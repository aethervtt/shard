{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "scripts/test-shard.mjs",
    "scripts/test-weights.json",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["SHARD_BENCH", "SHARD_CI", "SHARD_DAWN_OPTIONS", "SHARD_TEST_SHARD", "SHARD_WGSL_LOG"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
