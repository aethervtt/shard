{
  "name": "shard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4",
    "lint": "biome check .",
    "format": "biome check --write .",
    "playground": "pnpm --filter @shard/playground dev",
    "studio": "pnpm --filter @shard/studio tauri dev",
    "bench": "pnpm --filter @shard/core bench && SHARD_BENCH=1 turbo run test --concurrency=1 --force"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
