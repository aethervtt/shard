{
  "name": "shard",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4",
    "lint": "biome check .",
    "format": "biome check --write .",
    "playground": "pnpm --filter @aethervtt/shard-playground dev",
    "studio": "pnpm --filter @aethervtt/shard-studio tauri dev",
    "bench": "node scripts/bench.mjs",
    "build:wasm": "sh crates/shard-noise/build-wasm.sh && sh crates/shard-naga/build-wasm.sh",
    "check:wasm": "pnpm build:wasm && git diff --exit-code -- packages/noise/wasm packages/gpu-webgl2/wasm",
    "size": "pnpm --filter @aethervtt/shard-bench-size size",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
