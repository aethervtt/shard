{
  "$schema": "../../.shard/schemas/scatter.schema.json",
  "rules": [
    {
      "name": "boulders",
      "items": [
        { "generator": "shard/Rock", "params": { "radius": 0.9, "detail": 3 }, "variants": 4 }
      ],
      "density": 0.003,
      "spacing": 6,
      "align": 0.7,
      "scale": [0.6, 1.5],
      "sink": 0.15,
      "collider": "convex",
      "range": 300
    },
    {
      "name": "bushes",
      "items": [{ "generator": "shard/Bush", "variants": 4 }],
      "density": 0.02,
      "spacing": 2.5,
      "masks": { "slope": [0, 22] },
      "scale": [0.7, 1.3],
      "avoid": ["boulders"],
      "range": 150
    },
    {
      "name": "grass",
      "kind": "foliage",
      "items": [{ "generator": "shard/GrassClump", "variants": 4 }],
      "density": 5,
      "masks": { "slope": [0, 25] },
      "align": 0.4,
      "scale": [0.7, 1.4],
      "avoid": ["boulders"],
      "range": 50
    }
  ]
}
