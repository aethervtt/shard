{
  "$schema": "../.shard/schemas/scene.schema.json",
  "version": 1,
  "entities": [
    {
      "name": "camera",
      "components": {
        "render/Camera3d": {
          "projection": "orthographic",
          "orthoHeight": 16,
          "clearColor": [0.01, 0.012, 0.02, 1]
        },
        "core/Transform": {
          "translation": [10.5, 7.5, 10]
        }
      }
    },
    {
      "name": "maze",
      "components": {
        "core/Transform": {
          "translation": [0, 15, 0]
